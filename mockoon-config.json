      "responses": [
        {
          "uuid": "0df5a335-27b1-4506-bf3b-edd9ee26d46a",
          "body": "[\n  {\n    \"id\": \"e1\",\n    \"sender\": \"Google Cloud Platform\",\n    \"senderEmail\": \"noreply@googlecloud.com\",\n    \"avatar\": \"G\",\n    \"time\": \"10:30 AM\",\n    \"subject\": \"Invoice for October 2023 is available\",\n    \"summary\": \"Hóa đơn dịch vụ Cloud tháng 10. Tổng tiền: $150.00. Cần thanh toán trước ngày 25/11 để tránh gián đoạn dịch vụ.\",\n    \"body\": \"Dear Customer,\\n\\nYour invoice for October 2023 is now available. Please review and pay by the due date to avoid service interruption.\\n\\nAmount Due: $150.00\\nDue Date: November 25, 2023\\n\\nThank you for using Google Cloud Platform.\",\n    \"column\": \"inbox\",\n    \"priority\": \"high\",\n    \"isRead\": false,\n    \"isStarred\": false,\n    \"order\": 1,\n    \"createdAt\": \"2024-11-21T10:30:00Z\",\n    \"updatedAt\": \"2024-11-21T10:30:00Z\"\n  },\n  {\n    \"id\": \"e2\",\n    \"sender\": \"Nguyễn Văn A (Team Lead)\",\n    \"senderEmail\": \"vana@company.com\",\n    \"avatar\": \"A\",\n    \"time\": \"09:15 AM\",\n    \"subject\": \"Re: Cập nhật tiến độ dự án Mobile App\",\n    \"summary\": \"Yêu cầu gửi lại bản thiết kế UI mới nhất trước 4h chiều nay để review với khách hàng. Nhắc nhở team fix lỗi API đăng nhập.\",\n    \"body\": \"Hi team,\\n\\nCần gửi lại UI design và fix login API bug trước 4PM hôm nay để có thể demo với client.\\n\\nTasks cần hoàn thành:\\n- Update UI mockups\\n- Fix authentication flow\\n- Test on mobile devices\\n\\nCảm ơn cả team!\",\n    \"column\": \"inbox\",\n    \"priority\": \"medium\",\n    \"isRead\": false,\n    \"isStarred\": true,\n    \"order\": 2,\n    \"createdAt\": \"2024-11-21T09:15:00Z\",\n    \"updatedAt\": \"2024-11-21T09:15:00Z\"\n  },\n  {\n    \"id\": \"e3\",\n    \"sender\": \"Trần Thị B (HR)\",\n    \"senderEmail\": \"hr.tranb@company.com\",\n    \"avatar\": \"B\",\n    \"time\": \"08:45 AM\",\n    \"subject\": \"Thông báo: Họp team building tháng 11\",\n    \"summary\": \"Sự kiện team building dự kiến tổ chức vào cuối tháng 11. Địa điểm: Resort Vũng Tàu. Thời gian: 2 ngày 1 đêm.\",\n    \"body\": \"Dear team,\\n\\nTeam building event sẽ được tổ chức tại Vũng Tàu vào cuối tháng.\\n\\nChi tiết:\\n- Thời gian: 30/11 - 01/12\\n- Địa điểm: Paradise Resort Vũng Tàu\\n- Hoạt động: Team games, BBQ, beach party\\n\\nVui lòng confirm tham gia trước 25/11.\",\n    \"column\": \"inbox\",\n    \"priority\": \"low\",\n    \"isRead\": true,\n    \"isStarred\": false,\n    \"order\": 3,\n    \"createdAt\": \"2024-11-21T08:45:00Z\",\n    \"updatedAt\": \"2024-11-21T08:45:00Z\"\n  },\n  {\n    \"id\": \"e4\",\n    \"sender\": \"GitHub\",\n    \"senderEmail\": \"noreply@github.com\",\n    \"avatar\": \"G\",\n    \"time\": \"Yesterday\",\n    \"subject\": \"Security alert: New sign-in from Windows device\",\n    \"summary\": \"Phát hiện đăng nhập mới từ thiết bị Windows tại TP.HCM. Nếu không phải bạn, vui lòng thay đổi mật khẩu ngay.\",\n    \"body\": \"We detected a new sign-in to your GitHub account.\\n\\nDevice: Windows 11\\nLocation: Ho Chi Minh City, Vietnam\\nTime: November 21, 2024 at 2:30 PM\\n\\nIf this was you, you can ignore this email. If not, please secure your account immediately.\",\n    \"column\": \"todo\",\n    \"priority\": \"high\",\n    \"isRead\": false,\n    \"isStarred\": true,\n    \"order\": 1,\n    \"createdAt\": \"2024-11-21T14:30:00Z\",\n    \"updatedAt\": \"2024-11-21T14:30:00Z\"\n  },\n  {\n    \"id\": \"e5\",\n    \"sender\": \"Netflix\",\n    \"senderEmail\": \"info@netflix.com\",\n    \"avatar\": \"N\",\n    \"time\": \"2 days ago\",\n    \"subject\": \"New releases this week - Don't miss out!\",\n    \"summary\": \"Discover exciting new movies and TV shows added to Netflix this week including action, drama and comedy series.\",\n    \"body\": \"Check out our latest releases!\\n\\n🎬 New Movies:\\n- Action Thriller: Bangkok Heist\\n- Comedy: Office Romance\\n- Drama: Family Bonds\\n\\n📺 New Series:\\n- Tech Startup (Season 1)\\n- Mystery Island (Season 3)\\n\\nHappy watching!\",\n    \"column\": \"done\",\n    \"priority\": \"low\",\n    \"isRead\": true,\n    \"isStarred\": false,\n    \"order\": 1,\n    \"createdAt\": \"2024-11-20T12:00:00Z\",\n    \"updatedAt\": \"2024-11-20T12:00:00Z\"\n  }\n]",
